OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openrouter/free

# SQLite is used when DATABASE_URL is omitted.
# DATABASE_URL=postgresql+psycopg://testgen:password@localhost:5432/testgen
TESTGEN_API_URL=http://127.0.0.1:8000
# Use demo with uvicorn api.demo:app; durable uses api.main:app plus runs.worker.
TESTGEN_MODE=durable
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_MINUTES=30

# Stage 2 free-tier durable deployment. Keep false locally unless testing the
# anonymous-workspace flow. Use a unique random value of at least 32 characters.
TESTGEN_REQUIRE_WORKSPACE=false
# TESTGEN_WORKSPACE_SECRET=replace-with-a-long-random-secret

# Stage 2 free-tier durable deployment. Keep false locally unless testing the
# anonymous-workspace flow. Use a unique random value of at least 32 characters.
TESTGEN_REQUIRE_WORKSPACE=false
# TESTGEN_WORKSPACE_SECRET=replace-with-a-long-random-secret
